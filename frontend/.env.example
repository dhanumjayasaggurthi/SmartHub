# Main backend API (FastAPI app.py) — used by almost every page/hook,
# including the AI avatar assistant (Regwiz).
VITE_API_BASE_URL=

# Legacy Streamlit chatbot iframe, embedded on the separate /ai-assistant page.
VITE_API_AI_URL=https://awsbjvnval002j.jnj.com:8004

# EPod RAG page
VITE_API_EPOD_URL=https://awsbjvnval002j.jnj.com:8002

# RIMDocs RAG / Agentic pages
VITE_API_RIMDOCS_URL=https://awsbjvnval002j.jnj.com:8003
VITE_API_RIMDOCS_AGENTIC_URL=https://awsbjvnval002h.jnj.com:8003

# AD group object IDs — used client-side for role/permission display logic.
# Should match AD_GROUP_ADMIN / AD_GROUP_DQE_RIGHTTIME_SUPERUSER / AD_GROUP_IT_VIEWER
# on the backend (backend/.env or dq_config.json).
VITE_AD_GROUP_ADMIN=JRD-APP-DEV-RDH-DQE-ITADMIN-USR
VITE_AD_GROUP_DQE_RIGHTTIME_SUPERUSER=JRD-APP-DEV-RDH-DQE-SUPER-USER-USR
VITE_AD_GROUP_IT_VIEWER=JRD-APP-DEV-RDH-DQE-IT-USR

# Azure AD app registration used for MSAL login. Set these to switch
# tenants/app registrations per environment without touching code.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_AUTHORITY=