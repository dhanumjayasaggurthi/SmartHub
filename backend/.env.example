# ---- Azure OpenAI: CHAT (required for the assistant to respond at all) ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_TEMPERATURE=0.2

# ---- Azure OpenAI: EMBEDDINGS (required for KB retrieval / build_kb.py) ----
# Falls back to the CHAT vars above if left unset — only set these if the
# embedding model lives on a different resource/deployment than chat.
AZURE_OPENAI_EMBED_ENDPOINT=
AZURE_OPENAI_EMBED_API_KEY=
AZURE_OPENAI_EMBED_API_VERSION=
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ---- Azure OpenAI: TTS (avatar voice — falls back to 503, no voice, if unset) ----
AZURE_OPENAI_TTS_ENDPOINT=https://genaiapimna.jnj.com/openai-audio
AZURE_OPENAI_TTS_API_KEY=
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts-global
AZURE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
AZURE_OPENAI_TTS_VOICE=onyx
AZURE_OPENAI_TTS_SPEED=0.96
AZURE_OPENAI_TTS_INSTRUCTIONS=talk like a real person, not a podcast narrator

# ---- Azure AI Search (only if ASSISTANT_KB_BACKEND=azure_search) ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=portal-kb
AZURE_SEARCH_API_VERSION=2023-11-01

# ---- Assistant behavior ----
ASSISTANT_KB_BACKEND=numpy
ASSISTANT_SELF_BASE_URL=http://localhost:8000
# "true/false" or "/path/to/your/self-signed-cert.pem"
ASSISTANT_SELF_TLS_VERIFY=true
ASSISTANT_RETRIEVAL_MIN_SCORE=0.25
ASSISTANT_MAX_HISTORY_MESSAGES=20
ASSISTANT_ACTION_ACK_TIMEOUT=6
# Worker pools for the assistant (optional - these are the defaults).
# STREAM = open chats at once, PREP = setup lookups, TTS = voice clips being made at once.
ASSISTANT_STREAM_WORKERS=64
ASSISTANT_PREP_WORKERS=32
ASSISTANT_TTS_WORKERS=32

# ---- Portal database (PostgreSQL) — REQUIRED ----
# Every table the portal keeps (RBAC, audit log, Communication Center, Data API,
# Data Studio history, What's New, assistant memory) lives in one schema here.
# The role needs CREATE on the database the first time (to create the schema),
# then only on the schema. Pending migrations are applied at startup unless
# SMARTHUB_DB_AUTO_MIGRATE=false, in which case run `python db.py migrate`.
SMARTHUB_DB_DSN=host=localhost port=5432 dbname=smarthub user=smarthub password= sslmode=prefer
SMARTHUB_DB_SCHEMA=smarthub_core
SMARTHUB_DB_POOL_MAX=20
SMARTHUB_DB_POOL_TIMEOUT_MS=5000
SMARTHUB_DB_STATEMENT_TIMEOUT_MS=30000
SMARTHUB_DB_LOCK_TIMEOUT_MS=5000
SMARTHUB_DB_IDLE_TX_TIMEOUT_MS=60000
SMARTHUB_DB_CONNECT_TIMEOUT=5
SMARTHUB_DB_MAX_LIFETIME=1800
SMARTHUB_DB_AUTO_MIGRATE=true

# ---- Postgres Query Runner (Unstructured Explorer) — optional, falls back to
# dq_config.json's "postgres_query_runner" section if that's set instead ----
PGQR_HOST=
PGQR_PORT=5432
PGQR_USER=
PGQR_PASSWORD=
PGQR_DATABASE=
PGQR_MAINTENANCE_DATABASE=postgres
PGQR_SSLMODE=prefer
PGQR_STATEMENT_TIMEOUT=300
PGQR_MAX_STATEMENT_TIMEOUT=3600
PGQR_MAX_CONCURRENT_JOBS=6
PGQR_JOB_TTL_SECONDS=2700

# ---- Snowflake Query Runner — optional. Anything left blank falls back to
# dq_config.json's "snowflake_query_runner" section, then to the main
# "snowflake" section, so a minimal setup needs none of these ----
SFQR_ACCOUNT=
SFQR_USER=
SFQR_PASSWORD=
SFQR_PRIVATE_KEY_PATH=
SFQR_PRIVATE_KEY_PASSWORD=
SFQR_ROLE=
SFQR_WAREHOUSE=
SFQR_DATABASE=
SFQR_SCHEMA=
SFQR_STATEMENT_TIMEOUT=300
SFQR_MAX_STATEMENT_TIMEOUT=3600
SFQR_MAX_CONCURRENT_JOBS=6
SFQR_JOB_TTL_SECONDS=2700
# Set to false to make the whole page read-only regardless of RBAC role
# How long one copy statement may run before Snowflake stops it (default 4h) -
# a schema clone or a large INSERT is not a 5 minute job
SFQR_COPY_TIMEOUT=14400
SFQR_ALLOW_WRITES=true
# Only for deployments where writes use a second Snowflake login (the Table
# Copier reads with the vars above and writes with these). Anything left blank
# falls back to the read login; naming a password or a key file here switches
# the write side onto these credentials entirely.
SFQRW_ACCOUNT=
SFQRW_USER=
SFQRW_PASSWORD=
SFQRW_PRIVATE_KEY_PATH=
SFQRW_PRIVATE_KEY_PASSWORD=
SFQRW_ROLE=
SFQRW_WAREHOUSE=
SFQRW_DATABASE=
SFQRW_SCHEMA=

# ---- S3 Explorer — optional. Leave the credential vars blank to fall back to
# the host's instance/task role. Anything here also reads from dq_config.json's
# "s3_explorer" section ----
S3X_REGION=
S3X_ACCESS_KEY_ID=
S3X_SECRET_ACCESS_KEY=
S3X_SESSION_TOKEN=
S3X_PROFILE=
# Only for S3-compatible storage (MinIO etc.) — leave blank for AWS
S3X_ENDPOINT_URL=
# Comma-separated allow-list. Blank means every bucket the credentials can see
S3X_BUCKETS=
# Uploads and deletes are off unless this is explicitly true
S3X_ALLOW_WRITES=false
S3X_ALLOW_PRESIGN=true
S3X_PRESIGN_EXPIRY=900
S3X_PREVIEW_MAX_BYTES=524288
# Office documents (docx/doc/xlsx/xls/pptx) are read whole to be parsed, so they
# get their own ceiling (default 32 MB)
S3X_DOCUMENT_PREVIEW_MAX_BYTES=33554432
# Largest PDF or image streamed to the browser for the preview pane (default 60 MB)
S3X_INLINE_PREVIEW_MAX_BYTES=62914560
# Largest single upload accepted, in bytes (default 256 MB)
S3X_MAX_UPLOAD_BYTES=268435456
# Ceiling for the search screen's "keys read" slider - users can go lower, not higher
S3X_SEARCH_SCAN_CAP=200000
# More than one account: a JSON list of credential sets, each with the buckets it
# owns. The vars above stay the default account; anything a listed account leaves
# out falls back to them, except the credentials, which are used as a set. The
# same thing can be configured as "accounts" in dq_config.json, which is easier
# to read than a one-line JSON string.
# S3X_ACCOUNTS=[{"name":"dev","access_key_id":"...","secret_access_key":"...","buckets":["itx-bjv-rddlx-dev"]},{"name":"prod","access_key_id":"...","secret_access_key":"...","buckets":["itx-bjv-rddlx-prd"]}]

# ---- Rate limiting (Redis) — optional, falls back to in-memory per-process ----
ASSISTANT_REDIS_URL=
REDIS_URL=

# ---- App-wide ----
CORS_ORIGINS=http://localhost:3000