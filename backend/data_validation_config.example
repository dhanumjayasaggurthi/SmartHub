[denodo.dev]
driver_jar = /path/to/denodo-vdp-jdbcdriver.jar
driver_class = com.denodo.vdp.jdbc.Driver
jdbc_url = jdbc:denodo://dev-host.example.com:9999/database
user = CHANGE_ME
password = CHANGE_ME
; Optional — only used if live JDBC catalog introspection fails:
; known_tables = VIEW_ONE, VIEW_TWO, VIEW_THREE

[denodo.qa]
driver_jar = /path/to/denodo-vdp-jdbcdriver.jar
driver_class = com.denodo.vdp.jdbc.Driver
jdbc_url = jdbc:denodo://qa-host.example.com:9999/database
user = CHANGE_ME
password = CHANGE_ME

[denodo.prod]
driver_jar = /path/to/denodo-vdp-jdbcdriver.jar
driver_class = com.denodo.vdp.jdbc.Driver
jdbc_url = jdbc:denodo://prod-host.example.com:9999/database
user = CHANGE_ME
password = CHANGE_ME

; SQL Server — requires the Microsoft JDBC driver jar (mssql-jdbc-*.jar).
; Uses SQL Server authentication (username/password) — works the same
; whether this backend runs on Windows or Linux. Don't add
; integratedSecurity=true/authenticationscheme=NTLM to the URL; that's a
; different auth mode this connector doesn't use.
[sqlserver.dev]
driver_jar = /path/to/mssql-jdbc-13.4.0.jre11.jar
driver_class = com.microsoft.sqlserver.jdbc.SQLServerDriver
jdbc_url =
user =
password =

[sqlserver.qa]
driver_jar = /path/to/mssql-jdbc-13.4.0.jre11.jar
driver_class = com.microsoft.sqlserver.jdbc.SQLServerDriver
jdbc_url =
user =
password =

[sqlserver.prod]
driver_jar = /path/to/mssql-jdbc-13.4.0.jre11.jar
driver_class = com.microsoft.sqlserver.jdbc.SQLServerDriver
jdbc_url =
user =
password =

[grail.dev]
driver_jar = /path/to/mssql-jdbc-13.4.0.jre11.jar
driver_class = com.microsoft.sqlserver.jdbc.SQLServerDriver
jdbc_url =
user =
password =

[grail.qa]
driver_jar = /path/to/mssql-jdbc-13.4.0.jre11.jar
driver_class = com.microsoft.sqlserver.jdbc.SQLServerDriver
jdbc_url =
user =
password =

[grail.prod]
driver_jar = /path/to/mssql-jdbc-13.4.0.jre11.jar
driver_class = com.microsoft.sqlserver.jdbc.SQLServerDriver
jdbc_url =
user =
password =

; Databricks / Spark SQL — requires the Databricks JDBC driver jar. Two driver
; variants exist with different URL prefixes and class names — match
; driver_class to whichever prefix your jdbc_url actually uses:
;   jdbc:spark://...      -> com.simba.spark.jdbc.Driver       (older "Simba Spark" driver)
;   jdbc:databricks://... -> com.databricks.client.jdbc.Driver (newer rebranded driver)
; Auth uses a personal access token: username is always "token", the token
; itself goes below (not as "password").
[databricks.dev]
driver_jar = /path/to/SimbaSparkJDBC42.jar
driver_class = com.simba.spark.jdbc.Driver
jdbc_url =
token = CHANGE_ME

[databricks.qa]
driver_jar = /path/to/SimbaSparkJDBC42.jar
driver_class = com.simba.spark.jdbc.Driver
jdbc_url =
token = CHANGE_ME

[databricks.prod]
driver_jar = /path/to/SimbaSparkJDBC42.jar
driver_class = com.simba.spark.jdbc.Driver
jdbc_url =
token = CHANGE_ME

