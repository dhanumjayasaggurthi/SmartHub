; Each source can have per-environment sections: [source], [source.dev],
; [source.qa], [source.prod]. A plain [source] section (no suffix) is used
; as the fallback for any environment that doesn't have its own section —
; so if all envs share the same DB, just use [source] and skip the rest.

[insight7.dev]
user = CHANGE_ME
password = CHANGE_ME
dsn = dev-host.example.com:1521/SERVICE_NAME

[insight7.qa]
user = CHANGE_ME
password = CHANGE_ME
dsn = qa-host.example.com:1521/SERVICE_NAME

[insight7.prod]
user = CHANGE_ME
password = CHANGE_ME
dsn = prod-host.example.com:1521/SERVICE_NAME

; RIMDocs — same connector as Oracle above (also an Oracle database), just a
; separate section since it's a different instance/schema with its own creds.
[rimdocs.dev]
user = CHANGE_ME
password = CHANGE_ME
dsn = dev-rimdocs-host.example.com:1521/SERVICE_NAME

[rimdocs.qa]
user = CHANGE_ME
password = CHANGE_ME
dsn = qa-rimdocs-host.example.com:1521/SERVICE_NAME

[rimdocs.prod]
user = CHANGE_ME
password = CHANGE_ME
dsn = prod-rimdocs-host.example.com:1521/SERVICE_NAME

[postgresql.dev]
host = dev-host.example.com
port = 5432
user = CHANGE_ME
password = CHANGE_ME

[postgresql.qa]
host = qa-host.example.com
port = 5432
user = CHANGE_ME
password = CHANGE_ME

[postgresql.prod]
